{
	"compilerOptions": {
		"target": "es2024",
		"lib": ["es2024"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"forceConsistentCasingInFileNames": true,
		// Node runs these files directly by stripping the types, so imports carry their .ts
		// extension and nothing that needs real compilation (enums, namespaces) is allowed.
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true
	},
	"include": ["src/**/*.ts", "test/**/*.ts"]
}
