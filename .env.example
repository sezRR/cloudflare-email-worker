# The Gmail address whose inbox gets sorted.
GMAIL_USER=you@gmail.com

# App password from https://myaccount.google.com/apppasswords (needs 2-Step Verification).
# Spaces are ignored. It is revoked whenever the Google account password changes.
GMAIL_APP_PASSWORD=

TYPESAFE_AI_API_KEY=

# Where the inbox cursor is kept, for runs outside Docker (`pnpm start`). Docker ignores it:
# compose.yaml always points the container at its /data volume.
# STATE_PATH=./data/state.json

# When the host's cron starts the labeller, in crontab syntax. Read by `make cron-set`;
# run that again after changing it. Defaults to hourly.
CRON_SCHEDULE=0 * * * *
